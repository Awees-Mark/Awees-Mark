// Clase Sala, está compuesta por las otras clases a cuaales hace de "controlodora" de las clases: Asientos y Horarios
class Sala {
    private int numeroSala;
    private Horario horario;
    private List<Asiento> asientos;

    // Constructor de la clase Sala
    public Sala(int numeroSala, Horario horario, int totalAsientos) {
        this.numeroSala = numeroSala;
        this.horario = horario;
        this.asientos = new ArrayList<>();
        // Inicializamos los asientos

        for (int i = 1; i <= totalAsientos; i++) {
            asientos.add(new Asiento(String.valueOf(i)));
        }
    }

    // Getters y Setters
    public int getNumeroSala() {
        return numeroSala;
    }

    public Horario getHorario() {
        return horario;
    }

    public List<Asiento> getAsientos() {
        return asientos;
    }

    public void setNumeroSala(int numeroSala) {
        this.numeroSala = numeroSala;
    }

    public void setHorario(Horario horario) {
        this.horario = horario;
    }

    public void setAsientos(List<Asiento> asientos) {
        this.asientos = asientos;
    }

    // Método para mostrar la información de la Sala
    public void mostrarSala() {
        System.out.println("Sala: " + numeroSala);
        System.out.println("Horario: " + horario);
        System.out.println("Asientos:");
        for (Asiento a : asientos) {
            System.out.println("\n-----------------------------------");
        }
    }
    // Reservar un asiento dado su número (como String). También agregamos el manejo de errores: asiento no existe y asiento reservado
    public boolean reservarAsiento(String numeroAsiento) {
        for (Asiento a : asientos) {
            if (a.getNumeroAsiento().equals(numeroAsiento)) {
                if (!a.isReservado()) {
                    a.reservar();
                    return true;
                } else {
                    System.out.println("El asiento " + numeroAsiento + " ya está reservado.");
                    return false;
                }
            }
        }
        System.out.println("El asiento " + numeroAsiento + " no existe.");
        return false;
    }
}
