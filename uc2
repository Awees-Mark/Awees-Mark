class Pelicula {
     private String nombrePelicula;
     private String generoPelicula;
     private int duracion;

     // Constructor de Pelicula
    public Pelicula(String nombrePelicula, String generoPelicula, int duracion) {
            this.nombrePelicula = nombrePelicula;
            this.generoPelicula = generoPelicula;
            this.duracion = duracion;


        }

    // Getters y Setters Pelicula
    public String getNombrePelicula() {
        return this.nombrePelicula;
    }

    public String getGeneroPelicula() {
        return this.generoPelicula;
    }

    public int getDuracion() {
        return this.duracion;
    }

    public void setNombrePelicula(String nombrePelicula) {
        this.nombrePelicula = nombrePelicula;
    }

    public void setGeneroPelicula(String generoPelicula) {
        this.generoPelicula = generoPelicula;
    }

    public void setDuracion(int duracion) {
        this.duracion = duracion;
    }

    // Método para registrar Pélicula automáticamente en el ArrayList
    public Pelicula(String nombrePelicula, String generoPelicula, int duracion, Cartelera cartelera) {
        this(nombrePelicula, generoPelicula, duracion); // Llamamos al constructor de Película
        cartelera.agregarPelicula(this); // Método perteneciente a la clase Cartelera. Enlaza el automatismo, para que se agregue solas las Películas a la lista Cartelera
    }
}

