//Utilizando el patrón "Composite"

package Sistema_Cine;
import java.time.LocalTime;
import java.util.*;
import java.util.ArrayList;
import java.util.Scanner;
import java.time.format.DateTimeFormatter;


//______________________________________________________________________________________________________________//
// Clase controladora: se encargará de coordinar la lógica del sistema. Esta clase implementará los métodos de negocio, es decir, el flujo de funcionamiento del sistema
public class SistemaCine {
    private List<Cartelera> carteleras;
    private Sala sala;
    private Pago pago;

    // Constructo de la clase Sistema
    public SistemaCine(Cartelera cartelera, Sala sala, Pago pago) {
        this.carteleras = new ArrayList<>();
        this.sala = sala;
        this.pago = pago;
    }

    public void agregarCartelera(Cartelera cartelera) {
        carteleras.add(cartelera);
    }

    public Sala getSala() {
        return sala;
    }

    public Pago getPago() {
        return pago;
    }

    public void setSala(Sala sala) {
        this.sala = sala;
    }

    public void setPago(Pago pago) {
        this.pago = pago;
    }

    // Flujo principal de interacción con el usuario
    public void FlujoPrincipal() {
        System.out.println("Bienvenidos al Cine Interestelar");

        // Selección de cartelera
        System.out.println("Seleccione una Cartelera:");
        for (int i = 0; i < carteleras.size(); i++) {
            System.out.println((i + 1) + ". " + carteleras.get(i).getDiaSemana());
        }

        Scanner scanner = new Scanner(System.in);
        int opcionCartelera = scanner.nextInt();
        Cartelera carteleraSeleccionada = carteleras.get(opcionCartelera - 1);

        // Mostrar las películas de la cartelera seleccionada
        System.out.println("Películas disponibles en la cartelera del " + carteleraSeleccionada.getDiaSemana() + ":");
        for (int i = 0; i < carteleraSeleccionada.getPeliculas().size(); i++) {
            Pelicula p = carteleraSeleccionada.getPeliculas().get(i);
            System.out.println((i + 1) + ". " + p.getNombrePelicula());

            // Aquí llamamos al toString de la película para mostrar todos los detalles
            System.out.println(p.toString()); // Esto muestra toda la info: horarios y salas
        }

        // Selección de película
        System.out.print("Seleccione una película por número: ");
        int opcionPelicula = scanner.nextInt();
        Pelicula peliculaSeleccionada = carteleraSeleccionada.getPeliculas().get(opcionPelicula - 1);

        // Mostrar horarios de la película seleccionada
        System.out.println("Horarios disponibles para la película " + peliculaSeleccionada.getNombrePelicula() + ":");
        for (int i = 0; i < peliculaSeleccionada.getHorarios().size(); i++) {
            System.out.println((i + 1) + ". " + peliculaSeleccionada.getHorarios().get(i).getHoraInicio());
        }

        // Selección de horario
        System.out.print("Seleccione un horario por número: ");
        int opcionHorario = scanner.nextInt();
        Horario horarioSeleccionado = peliculaSeleccionada.getHorarios().get(opcionHorario - 1);
        System.out.println("Has seleccionado el horario: " + horarioSeleccionado.getHoraInicio());

        // Mostrar asientos disponibles
        System.out.println("Asientos disponibles:");
        for (Asiento a : horarioSeleccionado.getSala().getAsientos()) {  // Usamos la sala del horario seleccionado
            if (!a.isReservado()) {
                System.out.print(a.getNumeroAsiento() + " ");
            }
        }
        System.out.println(); // Salto de línea para mayor claridad

        // Selección de asiento
        System.out.print("Seleccione un asiento para reservar: ");
        String asientoSeleccionado = scanner.next();
        if (horarioSeleccionado.getSala().reservarAsiento(asientoSeleccionado)) {
            System.out.println("¡Reserva exitosa! Has reservado el asiento " + asientoSeleccionado + " para la película.");
        } else {
            System.out.println("La reserva no pudo completarse.");
        }

        // Aquí es donde se realiza el pago
        procesarPago(peliculaSeleccionada.getNombrePelicula(), horarioSeleccionado.getHoraInicio(), asientoSeleccionado, horarioSeleccionado);

    }
    // Método para controlar flujo principal: parte 2 (pagos)
    public void procesarPago(String nombrePelicula, String horario, String asientoSeleccionado, Horario horarioSeleccionado){
        Scanner scanner = new Scanner(System.in);

        // Ingreso de datos para la factura
        System.out.print("Ingrese su nombre para la factura: ");
        String nombreUsuario = scanner.next();
        Factura factura = new Factura("F" + (int)(Math.random() * 10000), nombreUsuario);

        double monto = 200.0;

        // Mostrar el monto a pagar y selección del tipo de tarjeta
        System.out.println("Monto a pagar por la reserva: $" + monto);
        System.out.println("Seleccione el tipo de tarjeta:");
        System.out.println("1. Tarjeta de Crédito");
        System.out.println("2. Tarjeta de Débito");
        int tipoTarjeta = scanner.nextInt();

        String numeroTarjeta, vencimientoTarjetaStr;
        int vencimientoTarjeta, cvv;

        // Ingreso de datos de la tarjeta
        scanner.nextLine(); // limpiar buffer
        System.out.print("Ingrese el número de la tarjeta (sin espacios): ");
        numeroTarjeta = scanner.nextLine();

        System.out.print("Ingrese el vencimiento de la tarjeta (MMAA): ");
        vencimientoTarjetaStr = scanner.nextLine();
        vencimientoTarjeta = Integer.parseInt(vencimientoTarjetaStr);

        System.out.print("Ingrese el CVV: ");
        cvv = scanner.nextInt();

        // Crear objeto MedioDePago dependiendo del tipo de tarjeta
        MedioDePago tarjeta = (tipoTarjeta == 2)
                ? new TarjetaDebito(numeroTarjeta, vencimientoTarjeta, cvv)
                : new TarjetaCredito(numeroTarjeta, vencimientoTarjeta, cvv);

        // Mostrar los detalles del pago y confirmar con el usuario
        System.out.println("\n----- Detalles del pago -----");
        System.out.println("Monto: $" + monto);
        System.out.println("Número de tarjeta: " + numeroTarjeta);
        System.out.println("Tipo de tarjeta: " + tarjeta.identificarTipoDeTarjeta());
        System.out.println("Factura: " + factura.getNumeroFactura());
        System.out.println("Usuario: " + nombreUsuario);

        // Preguntar al usuario si desea confirmar el pago
        System.out.println("\n¿Desea confirmar el pago?");
        System.out.println("1. Confirmar");
        System.out.println("2. Cancelar");
        System.out.print("Opción: ");
        int opcion = scanner.nextInt();

        if (opcion == 1) {
            // Si el usuario confirma, procesamos el pago
            Pago pago = new Pago(monto, tarjeta, factura);
            pago.procesarPago();

            // Mostrar resumen de la compra
            System.out.println("\n------ RESUMEN DE COMPRA ------");
            System.out.println("Nombre: " + nombreUsuario);
            System.out.println("Número de Sala: " + horarioSeleccionado.getSala().getNumeroSala());
            System.out.println("Película: " + nombrePelicula);
            System.out.println("Horario: " + horario);
            System.out.println("Asiento: " + asientoSeleccionado);
            System.out.println("Monto pagado: $" + monto);
            System.out.println("Factura N°: " + factura.getNumeroFactura());
            System.out.println("--------------------------------");

            // 📧 Simular descarga o envío de factura
            System.out.println("¿Desea descargar la factura o enviarla por correo?");
            System.out.println("1. Descargar");
            System.out.println("2. Enviar por correo");
            int opcionAccion = scanner.nextInt();

            switch (opcionAccion) {
                case 1:
                    System.out.println("Factura descargada como PDF (simulado).");
                    break;
                case 2:
                    System.out.print("Ingrese su email: ");
                    scanner.nextLine(); // limpiar buffer
                    String email = scanner.nextLine();
                    System.out.println("Factura enviada al correo: " + email + " (simulado).");
                    break;
                default:
                    System.out.println("Opción no válida. No se realizó ninguna acción.");
                    break;
            }

        } else {
            System.out.println("\nPago cancelado por el usuario.");
        }
    }


    //______________________________________________________________________________________________________________//
    //Metodo main para hacer pruebas
    public static void main(String[] args) {
        // Crear la sala con un número y el total de asientos (por ejemplo, 5 asientos)
        Sala sala = new Sala(1, 5);  // La sala número 1 tendrá 5 asientos

        // Crear los horarios para cada película
        Horario horario1 = new Horario("12:40PM", sala);
        Horario horario2 = new Horario("4:00PM", sala);
        Horario horario3 = new Horario("6:30PM", sala);
        Horario horario4 = new Horario("22:30PM", sala);

        // Crear listas de horarios para las películas
        List<Horario> horariosVDeVendetta = new ArrayList<>();
        horariosVDeVendetta.add(horario1);
        horariosVDeVendetta.add(horario4);

        List<Horario> horariosFreddyVsJason = new ArrayList<>();
        horariosFreddyVsJason.add(horario2);

        List<Horario> horariosAvatar = new ArrayList<>();
        horariosAvatar.add(horario3);

        List<Horario> horariosArmaMortal = new ArrayList<>();
        horariosArmaMortal.add(horario4);
        horariosArmaMortal.add(horario1);

        // Crear las carteleras
        Cartelera cartelera1 = new Cartelera("Martes 21");
        Cartelera cartelera2 = new Cartelera("Miércoles 22");

        // Crear las películas con horarios específicos
        Pelicula pelicula1 = new Pelicula("V de Vendetta", "Aventura/Acción", 180, cartelera1, horariosVDeVendetta);
        Pelicula pelicula2 = new Pelicula("Freddy vs Jason", "Terror", 166, cartelera1, horariosFreddyVsJason);
        Pelicula pelicula3 = new Pelicula("Avatar 2", "Ciencia Ficción", 210, cartelera2, horariosAvatar);
        Pelicula pelicula4 = new Pelicula("Arma Mortal 4", "Acción", 120, cartelera2, horariosArmaMortal);

        // Agregar películas a las carteleras
        cartelera1.agregarPelicula(pelicula1);
        cartelera1.agregarPelicula(pelicula2);
        cartelera2.agregarPelicula(pelicula3);
        cartelera2.agregarPelicula(pelicula4);

        // Crear tarjeta de crédito y factura
        TarjetaCredito tarjeta = new TarjetaCredito("1234-5678-9876-5432", 202601, 321);
        Factura factura = new Factura("FAC123", "Juan Pérez");

        // Crear el pago
        Pago pago = new Pago(1500.0, tarjeta, factura);

        // Crear el sistema de cine
        SistemaCine sistema = new SistemaCine(cartelera1, sala, pago);

        // Agregar carteleras al sistema
        sistema.agregarCartelera(cartelera1);
        sistema.agregarCartelera(cartelera2);

        // Aquí se llama al flujo principal para la interacción del usuario
        sistema.FlujoPrincipal();
    }
}
