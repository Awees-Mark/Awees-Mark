class Usuario {
    private String nombre;
    private String correo;
    private List<Pelicula> peliculasSeleccionadas; // Declaramos el atributo tipo array con la selección de peliculas por parte del usuario del usuario

    // Constructor de la clase Usuario
    public Usuario (String nombre, String correo){
       this.nombre = nombre;
       this.correo = correo;
       this.peliculasSeleccionadas = new ArrayList<>();
    }
// Getters y setters de la clase Usuario
    public String getNombre() {
        return nombre;
    }

    public String getCorreo() {
        return correo;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public void setCorreo(String correo) {
        this.correo = correo;
    }
    // Método adicional para llamar a la clase
    @Override
    public String toString() {
        return "Nombre: " + nombre + ", Correo: " + correo;
    }

}
//______________________________________________________________________________________________________________//
// Clase Cartelera
class Cartelera {
    private String diaSemana;
    private List<Pelicula> peliculas;


    // Constructor de la clase Cartelera
    public Cartelera(String diaSemana ) {
        this.diaSemana = diaSemana;
        this.peliculas = new ArrayList<>();
    }

    // Getters y Setters Cartelera
    public String getDiaSemana() {
        return diaSemana;
    }

    public List<Pelicula> getPeliculas() {
        return peliculas;
    }

    public void setDiaSemana(String diaSemana) {
        this.diaSemana = diaSemana;
    }

    public void setPeliculas(List<Pelicula> peliculas) {
        this.peliculas = peliculas;
    }

    // Métodos para añadir Película en la Cartelera
    public void agregarPelicula(Pelicula pelicula) {
        this.peliculas.add(pelicula);
    }

    // Método para mostrar todas las Películas (recorremos el Arraylist)
    public void mostrarPeliculas() {
        for (int i = 0; i < peliculas.size(); i++) {
            Pelicula p = peliculas.get(i);
            System.out.println((i + 1) + ".Título: " + p.getNombrePelicula());
            System.out.println("Género: " + p.getGeneroPelicula());
            System.out.println("Duración: " + p.getDuracion() + " minutos");
            System.out.println("Fecha:" + getDiaSemana());
            System.out.println("----------------------------");
        }
    }
}
//______________________________________________________________________________________________________________//
// Clase Sala, está compuesta por las otras clases a cuaales hace de "controlodora" de las clases: Asientos y Horarios
class Sala {
    private int numeroSala;
    private List<Asiento> asientos;

    // Constructor de la clase Sala
    public Sala(int numeroSala, int totalAsientos) {
        this.numeroSala = numeroSala;
        this.asientos = new ArrayList<>();
        // Inicializamos los asientos

        for (int i = 1; i <= totalAsientos; i++) {
            asientos.add(new Asiento(String.valueOf(i)));
        }

    }

    // Getters y Setters
    public int getNumeroSala() {
        return numeroSala;
    }

    public List<Asiento> getAsientos() {
        return asientos;
    }

    public void setNumeroSala(int numeroSala) {
        this.numeroSala = numeroSala;
    }

    public void setAsientos(List<Asiento> asientos) {
        this.asientos = asientos;
    }

    // Método para mostrar la información de la Sala
    public void mostrarSala() {
        System.out.println("Sala: " + numeroSala);
        System.out.println("Asientos:");
        for (Asiento a : asientos) {
            System.out.println(a);
        }
    }
    // Reservar un asiento dado su número (como String). También agregamos el manejo de errores: asiento no existe y asiento reservado
    public boolean reservarAsiento(String numeroAsiento) {
        for (Asiento a : asientos) {
            if (a.getNumeroAsiento().equals(numeroAsiento)) {
                if (!a.isReservado()) {
                    a.reservar();
                    return true;
                } else {
                    System.out.println("El asiento " + numeroAsiento + " ya está reservado.");
                    return false;
                }
            }
        }
        System.out.println("El asiento " + numeroAsiento + " no existe.");
        return false;
    }
}
//______________________________________________________________________________________________________________//
class Pelicula {
    private String nombrePelicula;
    private String generoPelicula;
    private int duracion; // en minutos
    private Cartelera cartelera; // Una película pertenece a una cartelera
    private List<Horario> horarios; // Lista de horarios asociados a la película

    // Constructor de la clase
    public Pelicula(String nombrePelicula, String generoPelicula, int duracion, Cartelera cartelera, List<Horario> horarios) {
        this.nombrePelicula = nombrePelicula;
        this.generoPelicula = generoPelicula;
        this.duracion = duracion;
        this.cartelera = cartelera;
        this.horarios = horarios;
    }

    // Getters y setters
    public String getNombrePelicula() {
        return nombrePelicula;
    }

    public void setNombrePelicula(String nombrePelicula) {
        this.nombrePelicula = nombrePelicula;
    }

    public String getGeneroPelicula() {
        return generoPelicula;
    }

    public void setGeneroPelicula(String generoPelicula) {
        this.generoPelicula = generoPelicula;
    }

    public int getDuracion() {
        return duracion;
    }

    public void setDuracion(int duracion) {
        this.duracion = duracion;
    }

    public Cartelera getCartelera() {
        return cartelera;
    }

    public void setCartelera(Cartelera cartelera) {
        this.cartelera = cartelera;
    }

    public List<Horario> getHorarios() {
        return horarios;
    }

    public void setHorarios(List<Horario> horarios) {
        this.horarios = horarios;
    }

    // Método para mostrar información de la película y sus horarios
    @Override
    public String toString() {
        StringBuilder info = new StringBuilder();
        info.append("Título: ").append(nombrePelicula)
                .append("\nGénero: ").append(generoPelicula)
                .append("\nDuración: ").append(duracion).append(" minutos")
                .append("\nHorarios disponibles:\n");

        // Añadir los horarios junto con la sala
        for (Horario horario : horarios) {
            info.append("- ").append(horario.toString())
                    .append(" - Sala: ").append(horario.getSala().getNumeroSala()) // Mostramos la sala aquí
                    .append("\n");
        }
        return info.toString();
    }

  }

//______________________________________________________________________________________________________________//
    // Clase que se encarga de manejar fecha y hora de una entrada al cine
class Horario {
    private String horaInicio;
    private Sala sala;

    //Constructores de la clase
    public Horario (String horaInicio, Sala sala) {
        this.horaInicio = horaInicio;
        this.sala = sala;

    }
    // Getters y Setters Horario

    public String getHoraInicio() {
    return this.horaInicio;
    }

    public Sala getSala() {
        return sala;
    }

    public void setHoraInicio() {
        this.horaInicio = horaInicio;
    }

    public void setSala(Sala sala) {
        this.sala = sala;
    }

    @Override
    public String toString() {
        return horaInicio;
    }
}
//______________________________________________________________________________________________________________//
class Asiento {
    private String numeroAsiento; // Índicamos el número de asiento para luego poder reservarlo
    private boolean reservado; // Índicamos el estado del asiento "Libre" o "Reservado"

    // Constructor de la clase
    public Asiento (String numeroAsiento) {
        this.numeroAsiento = numeroAsiento;
        this.reservado = false;
    }
    // Getters y Setters Asiento
    public String getNumeroAsiento() {
        return numeroAsiento;
    }

    public boolean isReservado() {
        return reservado;
    }

    public void setNumeroAsiento(String numeroAsiento) {
        this.numeroAsiento = numeroAsiento;
    }

    public void reservar() {
        this.reservado = true;
    }

    public void liberar () {
        this.reservado = false;
    }

    @Override
    public String toString () {
        return numeroAsiento + (reservado ? " (reservado) " : " (libre");
    }


}
//______________________________________________________________________________________________________________//
class Pago {
    private double monto;
    private MedioDePago medioDePago;
    private Factura factura;

    public Pago(double monto, MedioDePago medioDePago, Factura factura) {
        this.monto = monto;
        this.medioDePago = medioDePago;
        this.factura = factura;
    }

    public double getMonto() {
        return monto;
    }

    public MedioDePago getMedioDePago() {
        return medioDePago;
    }

    public Factura getFactura() {
        return factura;
    }

    public void setMonto(double monto) {
        this.monto = monto;
    }

    public void setMedioDePago(MedioDePago medioDePago) {
        this.medioDePago = medioDePago;
    }

    public void setFactura(Factura factura) {
        this.factura = factura;
    }

    public void procesarPago() {
        System.out.println("Procesando el pago...");
        System.out.println("Monto: $" + monto);
        System.out.println("Número Tarjeta: " + medioDePago.getNumeroTarjeta());
        System.out.println("Tipo de Tarjeta: " + medioDePago.identificarTipoDeTarjeta()); // Mostramos el tipo de tarjeta
        System.out.println("Factura: " + factura.getNumeroFactura());
        System.out.println("Usuario: " + factura.getNombreUsuario());
        System.out.println("Pago realizado correctamente.");
    }

}

//______________________________________________________________________________________________________________//
// Clase abstracta para métodos de pago
abstract class MedioDePago {
    private String numeroTarjeta;
    private int vencimientoTarjeta; // Podrías considerar usar tipo String para fechas como 'MM/YY'

    // Constructor
    public MedioDePago(String numeroTarjeta, int vencimientoTarjeta) {
        this.numeroTarjeta = numeroTarjeta;
        this.vencimientoTarjeta = vencimientoTarjeta;
    }

    public String getNumeroTarjeta() {
        return numeroTarjeta;
    }

    public int getVencimientoTarjeta() {
        return vencimientoTarjeta;
    }

    public void setNumeroTarjeta(String numeroTarjeta) {
        this.numeroTarjeta = numeroTarjeta;
    }

    public void setVencimientoTarjeta(int vencimientoTarjeta) {
        this.vencimientoTarjeta = vencimientoTarjeta;
    }

    // Método para identificar si es tarjeta de crédito o débito
    public abstract String identificarTipoDeTarjeta();

}

//______________________________________________________________________________________________________________//
// Implementación específica para tarjeta de crédito
class TarjetaCredito extends MedioDePago {
    private int cvvCredito; // CVV para tarjeta de crédito

    public TarjetaCredito(String numeroTarjeta, int vencimientoTarjeta, int cvvCredito) {
        super(numeroTarjeta, vencimientoTarjeta);
        this.cvvCredito = cvvCredito;
    }

    public int getCvvCredito() {
        return cvvCredito;
    }

    public void setCvvCredito(int cvvCredito) {
        this.cvvCredito = cvvCredito;
    }

    @Override
    public String identificarTipoDeTarjeta() {
        return "Tarjeta de Crédito";
    }

}

//______________________________________________________________________________________________________________//
// Implementación específica para tarjeta de débito
class TarjetaDebito extends  MedioDePago {
    private int cvvDebito; // CVV para tarjeta de débito

    public TarjetaDebito(String numeroTarjeta, int vencimientoTarjeta, int cvvDebito) {
        super(numeroTarjeta, vencimientoTarjeta);
        this.cvvDebito = cvvDebito;
    }

    public int getCvvDebito() {
        return cvvDebito;
    }

    public void setCvvDebito(int cvvDebito) {
        this.cvvDebito = cvvDebito;
    }

    @Override
    public String identificarTipoDeTarjeta() {
        return "Tarjeta de Débito";
    }

}


//______________________________________________________________________________________________________________//
class Factura {
    private String numeroFactura;
    private String nombreUsuario;

    // Constructor de clase factura
     public Factura (String numeroFactura, String nombreUsuario) {
         this.numeroFactura = numeroFactura;
         this.nombreUsuario = nombreUsuario;
     }
     // Getters y Setters Factura

    public String getNumeroFactura() {
         return numeroFactura;
    }

    public String getNombreUsuario() {
        return nombreUsuario;
    }

    public void setNumeroFactura(String numeroFactura) {
         this.numeroFactura = numeroFactura;
    }

    public void setNombreUsuario(String nombreUsuario) {
        this.nombreUsuario = nombreUsuario;
    }

    public String toString () {
         return "Nombre de Usuario" + nombreUsuario + "Número de Factura" + numeroFactura;
    }


}

